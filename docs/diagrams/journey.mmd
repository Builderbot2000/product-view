    classDef fit fill:#e9f6ee,stroke:#2f8a55
    classDef none fill:#f3f3f3,stroke:#999
    classDef note fill:#fff,stroke:#bbb,stroke-dasharray:4 3
    class REV ext
    class A0,A1,A2,T2 fit
    class B0,B1,B2 none
    class T0 note
